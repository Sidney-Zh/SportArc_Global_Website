{
  "name": "sportarc-global-website",
  "main": "_worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/",
      "/index.html"
    ]
  },
  "observability": {
    "enabled": true
  }
}
